# Build products
/build/
*.o
*.d
*.a
*.lib
*.obj

# Executables and hot-reload modules (including the uniquely named load copies)
/drifty
/drifty.exe
/drifty_release
/drifty_release.exe
/drifty_tests
/drifty_tests.exe
/drifty_hotreload_harness
/drifty_hotreload_harness.exe
/drifty_tests_cov
/drifty_tests_cov.exe
*.dll
*.so
*.dylib

# Windows debug artifacts
*.pdb
*.ilk
*.exp
*.idb
*.map

# Generated telemetry. tests/baselines/ is committed; telemetry/ output is not.
# Includes generated CSV rows and bounded visual smoke-test screenshots.
/telemetry/*
!/telemetry/.gitkeep

# Generated development-tool output. None of it is an input to a build.
# Named tuning profiles are the exception: they are reviewed handling decisions, so the
# committed .txt profiles survive while scratch output does not.
/artifacts/
/dist/
/tuning/*
!/tuning/default.txt
!/tuning/phase3-candidate.txt
/replays/

# Vendored dependencies fetched by CI or by the developer, rather than committed.
# third_party/raygui/ IS committed; these two are not.
/third_party/raylib-src/
/third_party/tracy/
compile_commands.json
*.gcda
*.gcno
*.gcov
/coverage/

# Editor / OS. The four committed VS Code files are the shared task, launch, and extension
# configuration described in docs/DEVTOOLS.md; everything else under .vscode/ is personal.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
.DS_Store

# Python tooling bytecode
__pycache__/
*.pyc

# Ad-hoc verification / scratch logs (output of `mk verify` redirected to a file)
mk_verify*.log

# Tooling
.clangd
opencode.json

# Local vehicle-visual planning notes (not project documentation)
ISSUE.md
SPRITE_OVERHAUL.md

# Reference sprite packs used only for human visual comparison during the
# vehicle-appearance work. Not game assets; issue #7 forbids redistributing them.
/resources/sprite_examples/

# BEGIN oh-my-opencode-slim clonedeps
.slim/*
# END oh-my-opencode-slim clonedeps
