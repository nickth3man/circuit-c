# Build products
/build/
*.o
*.d
*.a
*.lib
*.obj

# Executables and hot-reload modules (including the uniquely named load copies)
/drifty
/drifty.exe
/drifty_release
/drifty_release.exe
/drifty_tests
/drifty_tests.exe
/drifty_hotreload_harness
/drifty_hotreload_harness.exe
*.dll
*.so
*.dylib

# Windows debug artifacts
*.pdb
*.ilk
*.exp
*.idb
*.map

# Generated telemetry. tests/baselines/ is committed; telemetry/ output is not.
# Includes generated CSV rows and bounded visual smoke-test screenshots.
/telemetry/*
!/telemetry/.gitkeep

